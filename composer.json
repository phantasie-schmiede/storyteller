{
    "authors": [
        {
            "email": "dn@phantasie-schmiede.de",
            "name": "Daniel Ablass",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "PSB\\PsbStorybook\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PSB\\PsbStorybook\\Tests\\": "Tests/"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "description": "Blog-like way of publishing content with page browser",
    "extra": {
        "typo3/cms": {
            "app-dir": ".Build",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "psb_storybook",
            "web-dir": ".Build/public"
        }
    },
    "keywords": [
        "blog",
        "extension",
        "typo3"
    ],
    "license": "GPL-3.0-or-later",
    "name": "psb/psb-storybook",
    "require": {
        "psb/psb-foundation": "@dev"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.0.9"
    },
    "type": "typo3-cms-extension"
}
